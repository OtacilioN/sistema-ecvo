# ───────────── Banco de dados ─────────────
# Para desenvolvimento local, use uma branch Neon separada da production
# ou um Postgres local. Nunca use a branch production em npm run dev.
ECVO_DATABASE_ENV="development"

# String de conexão "pooled" (usada pela aplicação em runtime).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGION.aws.neon.tech/ecvo?sslmode=require"
# String de conexão "direta" (usada pelo Prisma para migrations).
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.REGION.aws.neon.tech/ecvo?sslmode=require"

# ───────────── Sessão / Autenticação ─────────────
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-secreta-de-32-bytes"

# ───────────── Tarefas agendadas ─────────────
# Usado pelo Vercel Cron para gerar aulas futuras de turmas recorrentes.
# Gere com: openssl rand -base64 32
CRON_SECRET="troque-por-uma-chave-secreta-para-cron"

# ───────────── Storage de fotos ─────────────
# Criado ao adicionar Vercel Blob ao projeto. Necessário para upload/leitura de fotos privadas.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ───────────── App ─────────────
# Usado em e-mails/links; em produção, a URL pública do app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ───────────── Asaas / PIX ─────────────
# Use "sandbox" localmente e em Preview/Development da Vercel. Vercel Production exige
# "production"; fora da Vercel, somente a confirmação explícita abaixo libera a conta real.
# O prefixo da chave deve corresponder ao ambiente antes de qualquer chamada de rede.
ASAAS_ENVIRONMENT="sandbox"
# Somente para produção fora da Vercel: confirmação explícita do deployment.
# ASAAS_PRODUCTION_CONFIRMED="ECVO_PRODUCTION"
ASAAS_API_KEY="\$aact_hmlg_..."
ASAAS_USER_AGENT="SistemaECVO/1.0"
ASAAS_TIMEOUT_MS="15000"
# Token exclusivo enviado pelo Asaas no header asaas-access-token (32 a 255 caracteres).
ASAAS_WEBHOOK_TOKEN="gere-um-segredo-exclusivo-com-pelo-menos-32-caracteres"
# Chave PIX cadastrada na mesma conta Asaas. Opcional na API, recomendada pelo provedor.
ASAAS_PIX_KEY="sua-chave-pix-cadastrada-no-asaas"

# ───────────── Web Push / PWA ─────────────
# Gere com: npx web-push generate-vapid-keys
# WEB_PUSH_SUBJECT deve ser uma URL https:// ou mailto: de contato.
WEB_PUSH_PUBLIC_KEY="vapid_public_key"
WEB_PUSH_PRIVATE_KEY="vapid_private_key"
WEB_PUSH_SUBJECT="mailto:suporte@ecvo.com.br"
